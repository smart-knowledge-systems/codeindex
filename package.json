{
  "name": "codeindex",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "codeindex": "src/index.ts",
    "cidx": "src/index.ts"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit --incremental --tsBuildInfoFile node_modules/tsconfig.tsbuildinfo",
    "lint": "bunx eslint --cache --cache-location node_modules/.eslintcache src/",
    "format": "bunx prettier -l --cache --cache-location node_modules/.prettiercache --write src/",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bunx prettier --cache --cache-location node_modules/.prettiercache --check src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/eslint__js": "^9.14.0",
    "eslint": "^10.0.3",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@easier-idx/core": "^0.2.0",
    "@easier-idx/embedding": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ignore": "^7.0.5",
    "openai": "^6.27.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.3"
  },
  "patchedDependencies": {
    "web-tree-sitter@0.25.3": "patches/web-tree-sitter@0.25.3.patch"
  }
}
