{
  "name": "codeindex",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "codeindex": "src/index.ts",
    "cidx": "src/index.ts"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit --incremental --tsBuildInfoFile node_modules/tsconfig.tsbuildinfo",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "check": "oxfmt --check && oxlint --type-aware && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@easier-idx/core": "^0.3.1",
    "@easier-idx/embedding": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ignore": "^7.0.14",
    "sqlite-vec": "^0.1.9",
    "web-tree-sitter": "0.25.3"
  },
  "patchedDependencies": {
    "web-tree-sitter@0.25.3": "patches/web-tree-sitter@0.25.3.patch"
  }
}
