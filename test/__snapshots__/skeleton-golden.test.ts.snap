"# sample.php [PHP]
imports: App\\Interfaces\\Renderable, App\\Traits\\HasTimestamps, Illuminate\\Database\\Eloquent\\Model

namespace App\\Models

interface Renderable
  + render() -> string
  + getTemplate() -> string

trait HasTimestamps
  + getCreatedAt() -> string
  + touch() -> void

class User
  - $name
  - $email
  + __construct($name: string, $email: string)
  + render() -> string
  + getTemplate() -> string
  + getName() -> string
  - validateEmail() -> bool

class Admin
  - $permissions
  + hasPermission($permission: string) -> bool

function formatUser($user: User) -> string

class Route
  + __construct($path: string, $method: string)

enum Status
  case Active
  case Inactive
  case Pending
  + label() -> string"
,
}
`;

