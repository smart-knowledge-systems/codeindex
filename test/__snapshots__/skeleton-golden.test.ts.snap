    """Open the connection."""
  + query(sql: str, params: Optional[List]) -> List[dict]
    """Execute a query and return rows."""
  @property
  + is_connected() -> bool
    """Check connection status."""

function create_pool(url: str, size: int) -> Database
  """Create a connection pool.""""
,
}
`;

