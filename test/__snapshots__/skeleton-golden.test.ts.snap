"# sample.zig [Zig]
imports: std, std, std

pub struct Point
  x: f64
  y: f64
  + init(x: f64, y: f64) -> Point
  + distance(self: Point, other: Point) -> f64

pub enum Direction
  variants: north, south, east, west
  + opposite(self: Direction) -> Direction

pub union Value
  variants: integer: i64, float: f64, string: []const u8, none
  + isNumeric(self: Value) -> bool

pub error ParseError
  values: InvalidSyntax, UnexpectedToken, OutOfMemory

pub function parseInt(input: []const u8) -> ParseError!i64

function helperFunction(allocator: std.mem.Allocator, size: usize) -> ![]u8

pub function maxValue(comptime T: type, a: T, b: T) -> T

test "Point distance"

test "Direction opposite""
,
}
