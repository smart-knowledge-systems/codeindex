"# sample.ex [Elixir]
imports: use GenServer, import Enum, require Logger

defmodule Animals.Dog
  defstruct [name, age, breed]
  def new(name, age)
  defp validate(dog)
  def speak(dog)
  def speak(_other)
  defmacro define_greeting(name)

defprotocol Describable
  def describe(data)

defimpl Describable, for: Animals.Dog
  def describe(dog)

defmodule Animals.Cat
  defstruct [name, color]
  def new(name, color \\\\ "black")
  defp purr()
  defmacrop internal_macro()

defmodule MathUtils
  def add(a, b)
  def subtract(a, b)
  def divide(_a, 0)
  def divide(a, b)"
,
}
`;

