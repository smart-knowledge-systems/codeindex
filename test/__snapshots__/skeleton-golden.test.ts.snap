"# sample.rb [Ruby]
imports: json, helpers/utils

module Animals
  class Animal
    attr_reader name, age
    + initialize(name, age)
    + speak()
    + to_s()

  class Dog < < Animal
    + speak()
    + fetch(item)

  class Cat < < Animal
    + speak()
    + self.create(name)


module Serializable
  + to_json()

+ greet(name)"
,
}
`;

