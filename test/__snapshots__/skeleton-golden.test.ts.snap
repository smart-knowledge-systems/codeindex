"# sample.kt [Kotlin]
imports: com.example.models.User, com.example.utils.Logger

data class Config

interface Repository
  + findById(id: String) -> T?
  + save(entity: T) -> T
  + delete(id: String)

class UserRepository
  + logger
  + findById(id: String) -> User?
  + save(entity: User) -> User
  + delete(id: String)
  + findByEmail(email: String) -> User?
  companion object
    + create(config: Config) -> UserRepository
    + default() -> UserRepository

object AppRegistry
  + services
  + register(name: String, service: Any)
  + get(name: String) -> Any?

function initializeApp(config: Config) -> UserRepository

val DEFAULT_CONFIG"
,
}
`;

