  "text": 
"# sample.scala [Scala]
imports: scala.collection.mutable, scala.concurrent.Future

object AppConfig
  val defaultPort: Int
  var debug: Boolean
  function load(path: String) -> AppConfig

class AppConfig
  val settings: mutable.Map[String, String]
  function get(key: String) -> Option[String]
  function set(key: String, value: String) -> Unit

trait Repository

case class User

class UserRepository
  val store: mutable.Map[Long, User]
  function findById(id: Long) -> Option[User]
  function save(entity: User) -> Unit
  function delete(id: Long) -> Boolean

type UserId = Long
val MaxRetries: Int
var currentUser: Option[User]
function createRepository() -> Repository[User]"
,
}
`;

