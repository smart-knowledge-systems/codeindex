trait Storage
  + get(&self, key: &str) -> Option<&str>
  + set(&mut self, key: String, value: String)

#[derive(Debug, Clone)]
struct MemoryStore

impl Storage for MemoryStore
  - get(&self, key: &str) -> Option<&str>
  - set(&mut self, key: String, value: String)

function create_store() -> MemoryStore"
,
}
