"# sample.swift [Swift]
imports: Foundation, UIKit

protocol Drawable

struct Point
  + x: Double
  + y: Double
  + distanceTo() -> Double

class Shape
  + color: String
  + name: String
  + init()
  + draw()
  + area() -> Double

class Circle
  + radius: Double
  + init()
  + area() -> Double

enum Direction
  + description() -> String

extension Shape
  + describe() -> String

typealias ShapeList = ShapeList
+ createShapes() -> ShapeList"
,
}
`;

